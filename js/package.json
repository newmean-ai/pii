{
  "name": "@newmean-ai/pii",
  "version": "1.7.2",
  "description": "Mask PII before it reaches your LLM: on-device multilingual PII detection and redaction in the browser and Node (54 languages, 2.6-15.5 MB models)",
  "license": "Apache-2.0",
  "author": "newmean.ai",
  "homepage": "https://github.com/newmean-ai/pii",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newmean-ai/pii.git",
    "directory": "js"
  },
  "keywords": [
    "pii",
    "privacy",
    "redaction",
    "anonymization",
    "ner",
    "onnx",
    "browser",
    "multilingual",
    "ai-sdk",
    "langchain",
    "llm",
    "pii-detection",
    "pii-redaction",
    "pii-masking",
    "data-masking",
    "llm-security",
    "guardrails"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "import": "./dist/ai-sdk.js",
      "default": "./dist/ai-sdk.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "import": "./dist/langchain.js",
      "default": "./dist/langchain.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "prepack": "npm run build && node scripts/check-pack.mjs",
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "vite demo"
  },
  "dependencies": {
    "onnxruntime-web": "1.31.1"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.2.1",
    "langchain": ">=1.5.1"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "langchain": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "0.28.2",
    "langchain": "^1.6.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
